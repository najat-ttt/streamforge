[Unit]
Description=StreamForge FastAPI app
After=network.target

[Service]
# Replace 'streamforge' with the system user that will own the app
User=streamforge
Group=streamforge

# Working directory of the backend repository
WorkingDirectory=/home/streamforge/streamforge-backend

# Path to virtualenv 'bin' directory (replace with your venv path)
Environment="PATH=/home/streamforge/venv/bin"

# ExecStart runs uvicorn from the virtualenv
ExecStart=/home/streamforge/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000

Restart=on-failure
RestartSec=5
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target

# Notes:
# - Replace 'User', 'WorkingDirectory' and 'Environment' with your deployment values.
# - Save this file to /etc/systemd/system/streamforge.service on the server.