## Environment variables for streamforge systemd service
# Example drop-in file. Place contents in /etc/systemd/system/streamforge.service.d/env.conf
# or use /etc/default/streamforge and reference it from the unit.

# Path to cookies.txt if you have authenticated cookies for yt-dlp. The
# Playwright refresh script in this repo writes `/home/streamforge/firefox-cookies.txt`.
COOKIEFILE=/home/streamforge/firefox-cookies.txt

# Comma-separated proxy list (optional):
# PROXY_LIST=http://1.2.3.4:8080,http://5.6.7.8:8080
PROXY_LIST=

# Rate limit (optional override for RATE_LIMIT used by the app):
# RATE_LIMIT=20/minute
RATE_LIMIT=20/minute

# Port uvicorn should bind to (if overridden)
PORT=8000

# Download limits (per-IP): short-term rate and daily quota
# Examples:
# DOWNLOAD_RATE="5/20minute"   -> 5 downloads per 20 minutes
# DOWNLOAD_DAILY="30/day"       -> 30 downloads per day
DOWNLOAD_RATE=5/20minute
DOWNLOAD_DAILY=30/day
