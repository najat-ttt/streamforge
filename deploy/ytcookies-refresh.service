[Unit]
Description=Playwright cookie refresh (streamforge)
After=network.target

[Service]
User=streamforge
Group=streamforge
Type=oneshot
WorkingDirectory=/home/streamforge/streamforge-backend
Environment=DISPLAY=:1
Environment=XDG_RUNTIME_DIR=/run/user/110
# Run the refresh script from the repository venv
ExecStart=/home/streamforge/venv/bin/python /home/streamforge/streamforge-backend/deploy/refresh_cookies.py
# During initial verification, avoid automatic restarts so failures are visible
# Allow systemd to retry on transient failures
Restart=on-failure
# Allow longer startup (Playwright/browser may take time)
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
